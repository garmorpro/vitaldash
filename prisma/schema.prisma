// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per day, per account. Weight, steps, and blood pressure are all
// logged independently, so all are optional — you might log a BP reading
// in the morning and weight isn't in yet, etc.
//
// userId is nullable at the DB level only to make the passkey-auth rollout
// possible without a hard schema migration: existing rows land with a null
// userId, then get backfilled onto the first account created via /setup.
// The application never writes a null userId going forward.
model DailyEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  weightLbs Decimal? @db.Decimal(5, 1)
  steps     Int?
  systolic  Int?
  diastolic Int?
  pulse     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_entries")
}

// A person who can sign in. No password — sign-in is entirely via a
// Face ID / Touch ID passkey (see Passkey below). Accounts are created
// either through the one-time /setup bootstrap (the very first account) or
// by redeeming an Invite from someone already signed in.
model User {
  id        String   @id @default(cuid())
  displayName String
  createdAt DateTime @default(now())

  // Per-account secret for the Apple Shortcuts step-count webhook
  // (POST /api/import/steps), so imported steps land on the right person.
  stepsImportToken String @unique

  passkeys       Passkey[]
  entries        DailyEntry[]
  invitesCreated Invite[]     @relation("InviteCreator")

  @@map("users")
}

// One WebAuthn credential (one enrolled Face ID / Touch ID) per row. A user
// could have more than one if they enroll from multiple devices.
model Passkey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId String  @unique
  publicKey    Bytes
  counter      Int     @default(0)
  deviceType   String
  backedUp     Boolean @default(false)
  transports   String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("passkeys")
}

// A one-time link generated by an existing account to bring someone else
// on. Redeeming one creates a User + their first Passkey and consumes the
// invite.
model Invite {
  id    String  @id @default(cuid())
  token String  @unique
  label String?

  createdByUserId String
  createdBy       User   @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@map("invites")
}
