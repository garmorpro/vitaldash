# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (generated client is platform-specific and regenerated on install
# via the postinstall script — never commit it)
/src/generated/

/src/generated/prisma

# iOS app (ios/VitalDash) — XcodeGen regenerates the .xcodeproj from
# project.yml, so the generated project isn't checked in (avoids .pbxproj
# merge conflicts); everyone runs `xcodegen generate` locally instead.
ios/VitalDash/VitalDash.xcodeproj/
ios/VitalDash/VitalDash/App/Info.plist
ios/VitalDash/DerivedData/
ios/VitalDash/build/
*.xcuserstate
