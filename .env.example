# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real credentials.

# Local Postgres (e.g. installed via `brew install postgresql@16`,
# managed/browsed through pgAdmin). Format:
# postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public
DATABASE_URL="postgresql://vitaldash_app:CHANGE_ME@localhost:5432/vitaldash?schema=public"

# Signs session cookies and the short-lived WebAuthn challenge cookies.
# Generate a real one with: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME"

# WebAuthn (Face ID / Touch ID) config. rpID is the bare domain (no
# protocol, no port); origin is the full https URL the app is served from.
# These must match exactly what's in the browser's address bar or passkeys
# will fail to verify.
WEBAUTHN_RP_ID="vitaldash.morganserver.com"
WEBAUTHN_ORIGIN="https://vitaldash.morganserver.com"

# One-time secret that gates /setup — the bootstrap page that creates the
# very first account. Generate a real one with: openssl rand -hex 16
# After the first account exists, /setup permanently refuses to create
# another one regardless of this token, so it's safe to leave set.
SETUP_TOKEN="CHANGE_ME"
